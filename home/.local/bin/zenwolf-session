#!/usr/bin/env bash
set -Eeuo pipefail
case "${1:-menu}" in
  status) printf 'kali-vmware\n'; exit 0 ;;
  menu)
    choice="$(printf '%s\n' 'Continue in Zenwolf' 'Exit to Kali console' 'Cancel' | rofi -dmenu -i -p 'Zenwolf session')" || exit 0
    case "$choice" in
      'Exit to Kali console')
        confirm="$(printf '%s\n' 'No' 'Yes, exit' | rofi -dmenu -i -p 'Exit Hyprland?')" || exit 0
        [[ "$confirm" == 'Yes, exit' ]] && exec "$HOME/.local/bin/zenwolf-exit-desktop"
        ;;
      *) exit 0 ;;
    esac
    ;;
  *) printf 'Usage: zenwolf-session {menu|status}\n' >&2; exit 2 ;;
esac
