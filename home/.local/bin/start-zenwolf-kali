#!/usr/bin/env bash
set -Eeuo pipefail

readonly config="$HOME/.config/hypr/hyprland.lua"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

if [[ "${EUID}" -eq 0 ]]; then
    printf 'Do not start the desktop as root. Log in as your normal Kali user.\n' >&2
    exit 1
fi
# Aquamarine cannot acquire the graphical seat from inside Kali XFCE/X11.
# Do not falsify XDG_SESSION_TYPE: fail early with an actionable message.
if [[ -n "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    printf 'ERROR: You are in an X11 desktop (DISPLAY=%s).\\n' "$DISPLAY" >&2
    printf 'Exit XFCE to the graphical login screen and select Hyprland there.\\n' >&2
    printf 'Check available sessions: ls /usr/share/wayland-sessions/\\n' >&2
    printf 'Or launch from a genuine text login console.\\n' >&2
    exit 2
fi
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    printf 'A Hyprland session is already active.\n' >&2
    exit 1
fi
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    printf 'A Wayland session is already active. Switch to a text TTY (Ctrl+Alt+F3) first.\n' >&2
    exit 1
fi
command -v Hyprland >/dev/null || {
    printf 'Hyprland is not installed. Run install-kali-research-workstation.sh first.\n' >&2
    exit 1
}
[[ -r "$config" ]] || {
    printf 'Missing Zenwolf Hyprland config: %s\n' "$config" >&2
    exit 1
}

printf 'Checking the Zenwolf Hyprland configuration...\n'
Hyprland --verify-config --config "$config"
printf '\nStarting Zenwolf on VMware virtual graphics. No AMD/NVIDIA device is forced.\n'
printf 'To return to Kali, press Super+Shift+Q or switch to a TTY.\n'
exec Hyprland --config "$config"
